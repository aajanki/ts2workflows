{
  "name": "ts2workflows",
  "version": "0.15.0",
  "description": "Transpile Typescript code to GCP Workflows programs",
  "homepage": "https://github.com/aajanki/ts2workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aajanki/ts2workflows.git"
  },
  "bugs": "https://github.com/aajanki/ts2workflows/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:functionmetadata && tsc --build",
    "build:functionmetadata": "node scripts/generateBlockingFunctionMetadata.js",
    "lint": "oxlint src test scripts",
    "format": "prettier . --write",
    "test": "mocha",
    "test:coverage": "nyc --reporter=text --reporter=html mocha",
    "prepare": "husky && npm run build"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "oxlint"
    ],
    "test/**/*.ts": [
      "prettier --write",
      "oxlint"
    ],
    "scripts/**/*.ts": [
      "prettier --write",
      "oxlint"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "bin": {
    "ts2workflows": "./dist/cli.js"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "language_reference.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "Antti Ajanki",
  "license": "MIT",
  "keywords": [
    "gcp",
    "gcloud",
    "workflows",
    "transpiler"
  ],
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@types/chai": "5.2.3",
    "@types/debug": "4.1.13",
    "@types/mocha": "10.0.10",
    "@types/node": "^20",
    "@types/ramda": "0.32.0",
    "chai": "6.2.2",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "mocha": "11.7.6",
    "nyc": "18.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.4",
    "rimraf": "6.1.3",
    "source-map-support": "0.5.21",
    "tsx": "4.23.1",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "typescript": ">=5.5.4 <7"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "8.65.0",
    "commander": "15.0.0",
    "debug": "4.4.3",
    "ramda": "0.32.0",
    "ts-brand": "0.2.0",
    "yaml": "2.9.0"
  }
}
