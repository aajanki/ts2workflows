exports[`Try-catch-finally statement > transpiles break inside try without a finalizer  1`] = `
{
  "main": {
    "steps": [
      {
        "try1": {
          "except": {
            "as": "err",
            "steps": [
              {
                "call_sys_log_1": {
                  "args": {
                    "data": "\${err}",
                  },
                  "call": "sys.log",
                },
              },
            ],
          },
          "try": {
            "steps": [
              {
                "assign1": {
                  "assign": [
                    {
                      "total": 0,
                    },
                  ],
                },
              },
              {
                "for1": {
                  "for": {
                    "in": [
                      1,
                      2,
                      3,
                    ],
                    "steps": [
                      {
                        "switch1": {
                          "switch": [
                            {
                              "condition": "\${i % 2 == 0}",
                              "next": "break",
                            },
                          ],
                        },
                      },
                      {
                        "assign2": {
                          "assign": [
                            {
                              "total": "\${total + i}",
                            },
                          ],
                        },
                      },
                    ],
                    "value": "i",
                  },
                },
              },
              {
                "return1": {
                  "return": "\${total}",
                },
              },
            ],
          },
        },
      },
    ],
  },
}
`;

