                  "assign": [
                    {
                      "__temp": "\${log("Error!")}",
                    },
                  ],
                },
              },
            ],
          },
          "retry": {
            "backoff": {
              "max_delay": 60,
            },
            "max_retries": 3,
            "predicate": "\${http.default_retry_predicate}",
          },
          "try": {
            "steps": [
              {
                "call_http_get_1": {
                  "args": {
                    "url": "https://visit.dreamland.test/",
                  },
                  "call": "http.get",
                  "result": "response",
                },
              },
              {
                "return1": {
                  "return": "\${response}",
                },
              },
            ],
          },
        },
      },
    ],
  },
}
`;

